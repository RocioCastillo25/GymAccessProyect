# Variables de entorno del Sistema de Gestión para Gimnasio (Sprint 1)
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir .env al repositorio (SC-005).

# Conexión a MySQL local (FR-025)
DB_HOST=localhost
DB_PORT=3306
DB_USER=gymapp
DB_PASSWORD=cambie_esta_clave
DB_NAME=gymaccess

# Autenticación (FR-003, clarify 2026-10-09)
JWT_SECRET=cambie_una_clave_secreta_larga
JWT_EXPIRES_IN=60m

# Puerto del backend
PORT=3000

# Reconocimiento facial (Sprint 2, research R4)
FACIAL_UMBRAL=0.6
FACIAL_MAX_INTENTOS=3

# Semilla del usuario administrador (contraseña mínimo 8 caracteres)
SEED_ADMIN_EMAIL=admin@gimnasio.local
SEED_ADMIN_PASSWORD=CambieClave123
SEED_ADMIN_NAME=Administrador
