# Variables de entorno del backend (FR-025, FR-026)
# Copiar como backend/.env y completar. NUNCA subirlo al repositorio.

DB_HOST=localhost
DB_PORT=3306
DB_USER=gymapp
DB_PASSWORD=cambie_esta_clave
DB_NAME=gymaccess

JWT_SECRET=cambie_una_clave_secreta_larga
JWT_EXPIRES_IN=60m

PORT=3000
NODE_ENV=development

# Orígenes permitidos para CORS, separados por comas (opcional).
# En desarrollo se puede dejar vacío para permitir el origen local.
CORS_ORIGIN=http://localhost:5173

# Reconocimiento facial (Sprint 2, research R4)
FACIAL_UMBRAL=0.6
FACIAL_MAX_INTENTOS=3

# Semilla del usuario administrador inicial
SEED_ADMIN_EMAIL=admin@gimnasio.local
SEED_ADMIN_PASSWORD=CambieClave123
SEED_ADMIN_NAME=Administrador
